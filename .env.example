NODE_ENV=development
PORT=4000

MONGODB_URI=mongodb://127.0.0.1:27017/aura_trading

JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=7d
JWT_COOKIE_NAME=aura_token

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/api/auth/google/callback

FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:4000
CORS_ORIGIN=http://localhost:3000

# Market data — leave empty to use DevelopmentMarketDataProvider
MARKET_DATA_PROVIDER=development
MARKET_DATA_API_KEY=
MARKET_DATA_API_URL=

# Broker — leave empty to use PaperBrokerAdapter
BROKER_PROVIDER=paper
BROKER_API_KEY=
BROKER_API_SECRET=
BROKER_REDIRECT_URI=

WEBSOCKET_URL=http://localhost:4000

# Development / E2E only — never enable in production
ENABLE_TEST_AUTH=true
TEST_AUTH_SECRET=dev-test-auth-secret

# Cookie / security
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200

# Frontend (copy NEXT_PUBLIC_* into frontend/.env.local)
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_WS_URL=http://localhost:4000
NEXT_PUBLIC_APP_NAME=Aura
